diff --git a/devices/harness-device/firmware/main/CMakeLists.txt b/devices/harness-device/firmware/main/CMakeLists.txt
index 04e65612..3cd943bd 100644
--- a/devices/harness-device/firmware/main/CMakeLists.txt
+++ b/devices/harness-device/firmware/main/CMakeLists.txt
@@ -113,7 +113,7 @@ idf_component_register(
         "ui"
         "board"
     REQUIRES ${BOARD_REQUIRES}
-    EMBED_FILES ${COMPANION_ART}
+    EMBED_FILES ${COMPANION_ART} "../assets/audio/waiting.s16le"
 )
 
 # snprintf() is bounded (it truncates, never overflows), but -O2 enables a noisy
@@ -227,3 +227,18 @@ if(DEVICE_RENDER_STRESS)
     endif()
     target_compile_definitions(${COMPONENT_LIB} PRIVATE DEVICE_RENDER_STRESS=1)
 endif()
+
+# The standard Waveshare 1.75 has a different audio MCLK and PWR-key input.
+# Explicit opt-in; never infer this wiring from the shared touch-controller ID.
+if(DEVICE_BOARD STREQUAL "waveshare-standard")
+    target_compile_definitions(${COMPONENT_LIB} PRIVATE DEVICE_WAVESHARE_STANDARD=1)
+    # Fallback for an unset/corrupt saved rotation. The on-device setting wins.
+    # Top matches the current enclosure; left supports the original prototype.
+    if(NOT DEFINED DEVICE_USB_POSITION OR DEVICE_USB_POSITION STREQUAL "top")
+        target_compile_definitions(${COMPONENT_LIB} PRIVATE DEVICE_WAVESHARE_USB_TOP=1)
+    elseif(NOT DEVICE_USB_POSITION STREQUAL "left")
+        message(FATAL_ERROR "DEVICE_USB_POSITION must be top or left")
+    endif()
+elseif(DEFINED DEVICE_BOARD AND NOT DEVICE_BOARD STREQUAL "dial")
+    message(FATAL_ERROR "DEVICE_BOARD must be dial or waveshare-standard")
+endif()
diff --git a/devices/harness-device/firmware/main/app_main.c b/devices/harness-device/firmware/main/app_main.c
index 18148687..2ccb7220 100644
